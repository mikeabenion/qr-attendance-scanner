
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student QR Attendance Scanner</title>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 600px;
      margin: 25px auto;
      padding: 15px;
      text-align: center;
    }
    #reader { width: 100%; }
    #result {
      margin-top: 18px;
      padding: 12px;
      background: #f1f5f9;
      border-radius: 8px;
      overflow-wrap: anywhere;
    }
    button {
      padding: 12px 18px;
      margin: 8px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <h2>QR Attendance Scanner</h2>
  <p>Scan a student's QR code to record attendance.</p>

  <div id="reader"></div>
  <div id="result">Camera not started.</div>

  <button onclick="startScanner()">Start Scanner</button>
  <button onclick="stopScanner()">Stop Scanner</button>

  <script>
    // Replace with your deployed Apps Script /exec URL
    const SCRIPT_URL = "PASTE_YOUR_APPS_SCRIPT_EXEC_URL_HERE";

    let scanner = null;
    let busy = false;
    let lastCode = "";
    let lastScanTime = 0;

    function show(message) {
      document.getElementById("result").textContent = message;
    }

    function startScanner() {
      if (scanner) return;

      scanner = new Html5Qrcode("reader");

      scanner.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 250, height: 250 } },
        onScan,
        function () {}
      ).then(() => {
        show("Camera started. Scan a student QR code.");
      }).catch(error => {
        scanner = null;
        show("Camera error: " + error);
      });
    }

    function stopScanner() {
      if (!scanner) return;

      scanner.stop().then(() => {
        scanner.clear();
        scanner = null;
        show("Scanner stopped.");
      }).catch(error => show("Stop error: " + error));
    }

    function onScan(decodedText) {
      const now = Date.now();

      if (busy) return;
      if (decodedText === lastCode && now - lastScanTime < 5000) return;

      busy = true;
      lastCode = decodedText;
      lastScanTime = now;

      show("Processing attendance...");

      const callbackName =
        "attendanceCallback_" + now + "_" +
        Math.floor(Math.random() * 10000);

      const script = document.createElement("script");
      const timeout = setTimeout(() => {
        cleanup();
        show("Request timed out. Check the Apps Script deployment.");
        busy = false;
      }, 15000);

      function cleanup() {
        clearTimeout(timeout);
        delete window[callbackName];
        script.remove();
      }

      window[callbackName] = function(data) {
        cleanup();

        if (data.success) {
          show("Attendance response: " + JSON.stringify(data.result));
        } else {
          show("Attendance error: " + data.message);
        }

        busy = false;
      };

      script.onerror = function() {
        cleanup();
        show("Could not reach Apps Script. Check the /exec URL and deployment access.");
        busy = false;
      };

      const url = new URL(SCRIPT_URL);
      url.searchParams.set("action", "scan");
      url.searchParams.set("qrValue", decodedText);
      url.searchParams.set("callback", callbackName);

      script.src = url.toString();
      document.body.appendChild(script);
    }
  </script>
</body>
</html>
